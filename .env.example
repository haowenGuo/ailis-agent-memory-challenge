# AML Add/Search server only. Never paste upstream AILIS model credentials here.
AML_HOST=127.0.0.1
AML_PORT=8787
AML_VARIANT=lossless
AML_DATA_DIR=/var/lib/ailis-aml
# Generate a dedicated random secret during deployment; this is not an Eval Key.
AML_MEMORY_KEY=
AML_CACHE_SCOPES=8
AML_CACHE_BYTES=67108864
AML_MAX_IN_FLIGHT=4
AML_VERSION=v0.1.0-aml
# Only set when Linux launches Node via flock --nonblock --no-fork.
# AML_EXTERNAL_LOCK=flock
